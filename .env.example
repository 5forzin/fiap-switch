APP_MODE=production
ENVIRONMENT=production
AUTH_MODE=local
POWER_MODE=fiap
# Para AWS: região e VPC autorizada. A identidade IAM fica no controlador.
AWS_REGION=us-east-2
AWS_VPC_ID=
# Para Azure: assinatura e grupo autorizado. Use identidade gerenciada no controlador.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
BASE_URL=https://switch.example.com
DATABASE_PATH=data/switch.db
SESSION_SECRET=substitua-por-pelo-menos-32-caracteres-aleatorios
COLLECTOR_ID=campus
COLLECTOR_TOKEN=substitua-por-pelo-menos-32-caracteres-aleatorios
COOKIE_SECURE=true
# Autenticação opcional com Microsoft Entra (AUTH_MODE=entra).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
BOOTSTRAP_ADMIN_OID=
